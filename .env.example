# Copy to .env (gitignored) and fill in locally. Never commit .env. Names only here.
# Server and vision
SERVER_PORT=8000
VISION_URL=http://127.0.0.1:8001
# Brain (Claude) and backup brain switch
ANTHROPIC_API_KEY=
LLM_PROVIDER=claude
GROK_API_KEY=
# Voice
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
# Market
APIFY_TOKEN=
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
# Store
CONVEX_URL=
CONVEX_DEPLOY_KEY=
# Privacy: 1 keeps frames on our own vision host only (never a cloud model)
LOCAL_ONLY=0

# Shared secret required before exposing a public tunnel
A_EYE_TOKEN=
# Web accounts: OAuth web client ID and a random signing secret of at least 32 bytes.
GOOGLE_CLIENT_ID=
SESSION_SECRET=
# Set to 1 for offline phone testing
A_EYE_MOCK=
TWELVELABS_API_KEY=

# Cloudflare Access team domain, with or without https://
CF_ACCESS_TEAM_DOMAIN=
# Cloudflare Access application audience
CF_ACCESS_AUD=
# Local expert for LOCAL_ONLY or no key. Must NOT be a vision model (it would slow grounding). Empty = no local expert.
EXPERT_LOCAL_MODEL=

# Hosted open-model brain (cloud; Claude consent switch applies). Set BRAIN=openai_compat.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_TALKER_MODEL=
OPENAI_COMPAT_EXPERT_MODEL=

# Cloud vision (requires the per-call Google switch)
GEMINI_API_KEY=
GEMINI_VISION_MODEL=

# Local service URLs (runtime defaults are loopback; benchmark scripts require explicit URLs)
# OLLAMA_URL=http://127.0.0.1:11434
# BOX_URL=http://127.0.0.1:8090
# ROUTER_OLLAMA_URL=http://127.0.0.1:11434
PC_TAILSCALE_IP=
PC_USER=
PC_NAME=
# GPU startup and overnight scripts
BOX_VENV=
STT_MODEL=
YOLO_WEIGHTS=
KOKORO_DIR=
OLLAMA_EXE=
WSL_SETUP_SCRIPT=
PC_WORK_DIR=
PC_WINDOWS_MODELS_DIR=
NIGHT_LOG_DIR=
