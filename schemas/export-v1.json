          "privacy": "personal",
          "pattern": "^[0-9a-f]{64}$"
        },
        "call_id": {
          "type": "string",
          "description": "Pseudonymous parent call id.",
          "unit": "identifier",
          "privacy": "personal",
          "pattern": "^[0-9a-f]{64}$"
        },
        "item": {
          "type": "string",
          "description": "Tagged object name; no scene caption.",
          "unit": "text",
          "privacy": "personal"
        },
        "place": {
          "type": [
            "string",
            "null"
          ],
          "description": "Nearby place label; no image or embedding. Null means unavailable.",
          "unit": "text",
          "privacy": "personal"
        },
        "kind": {
          "type": "string",
          "description": "Memory event category, e.g. sighting.",
          "unit": "label",
          "privacy": "personal"
        },
        "t": {
          "type": "number",
          "description": "Observation timestamp.",
          "unit": "Unix seconds",
          "privacy": "personal",
          "minimum": 0
        },
        "frames": {
          "description": "Forbidden source payload; always dropped and invalid in exported rows.",
          "unit": "payload",
          "privacy": "never-export",
          "not": {}
        },
        "audio": {
          "description": "Forbidden source payload; always dropped and invalid in exported rows.",
          "unit": "payload",
