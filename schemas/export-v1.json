          "unit": "count",
          "privacy": "public",
          "minimum": 0
        },
        "level": {
          "type": "string",
          "description": "Recorded assistance or progress level; producer-defined label.",
          "unit": "label",
          "privacy": "personal"
        },
        "frames": {
          "description": "Forbidden source payload; always dropped and invalid in exported rows.",
          "unit": "payload",
          "privacy": "never-export",
          "not": {}
        },
        "audio": {
          "description": "Forbidden source payload; always dropped and invalid in exported rows.",
          "unit": "payload",
          "privacy": "never-export",
          "not": {}
        },
        "crops": {
          "description": "Forbidden source payload; always dropped and invalid in exported rows.",
          "unit": "payload",
          "privacy": "never-export",
          "not": {}
        },
        "raw_transcripts": {
          "description": "Forbidden source payload; always dropped and invalid in exported rows.",
          "unit": "payload",
          "privacy": "never-export",
          "not": {}
        }
      },
      "required": [
        "v",
        "entity",
        "id",
        "call_id",
        "task",
        "step",
        "hints_used",
        "level"
      ]
    },
